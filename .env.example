COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
NGIJO_API_BASE_URL=http://localhost:8101
CANGAR_API_BASE_URL=http://localhost:8102
JATIKERTO_API_BASE_URL=http://localhost:5001/api
